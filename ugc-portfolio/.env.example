# Copie este arquivo para ".env.local" e preencha com os dados
# do seu projeto Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# Opcional — em resend.com, pra receber um email a cada novo pedido de orçamento.
# Sem essa variável o formulário continua funcionando normalmente, só não avisa por email.
RESEND_API_KEY=sua-chave-da-resend
